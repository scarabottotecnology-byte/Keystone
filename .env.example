# Keystone Growth OS — modelo de ambiente.
# Copie para .env e preencha. O .env não é versionado.
#
# Projeto Supabase: keystone-growth-os
# Ref:              rplnjrqpzqznbxfascqs
# Região:           sa-east-1 (São Paulo)
# Painel:           https://supabase.com/dashboard/project/rplnjrqpzqznbxfascqs

VITE_SUPABASE_URL=https://rplnjrqpzqznbxfascqs.supabase.co

# Chave publishable (formato sb_publishable_...). É pública por natureza — vai
# no bundle do frontend. O que protege o dado é a RLS, não o sigilo da chave.
# Preferida sobre a `anon` legada: pode ser rotacionada sozinha.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ─────────────────────────────────────────────────────────────────────────────
# NÃO coloque a service_role aqui.
#
# Qualquer variável com prefixo VITE_ é embutida no bundle e fica legível para
# qualquer visitante. A service_role ignora RLS: exposta, ela dá acesso total
# ao banco. Ela pertence ao cofre de segredos das Edge Functions
# (`supabase secrets set`), nunca a este arquivo.
# ─────────────────────────────────────────────────────────────────────────────
